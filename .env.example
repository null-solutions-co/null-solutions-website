# ── NULL Solutions — frontend environment ──────────────────────────────
# Copy to .env.local and fill in. .env.local is git-ignored.
# Connecting to NULL Platform: see docs/PLATFORM.md.

# Base URL of the portal API — NULL Platform's /api/v1. The BFF (app/api/*)
# proxies to this server-to-server; the browser never calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public origin of this site (absolute URLs, metadata, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# "mock"  → the portal runs on the in-memory mock backend (mocks/), no API needed.
#           The default in development. Never switches itself on in production.
# "live"  → the BFF talks to NEXT_PUBLIC_API_URL (NULL Platform).
# unset in a production build → the public site works, the portal answers 503.
NEXT_PUBLIC_API_MODE=live

# Secret the BFF uses to encrypt the session cookie. 32+ random chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in production: the server refuses to start a session without it.
SESSION_SECRET=replace-with-a-long-random-string

# NULL Platform origin (no path). The site's texts, portfolio and contact
# details are read from ${NULL_CMS_URL}/api/public/* (cached 60 s), with the
# bundled messages/*.json, PORTFOLIO and COMPANY as the fallback.
# Unset → bundled content only (as in mock mode / tests).
NULL_CMS_URL=http://localhost:3000

# Shared secret of the revalidation webhook (POST /api/revalidate). Set the
# same value as "revalidateSecret" in the platform's /admin/settings → website,
# with revalidateUrl = <this site>/api/revalidate. Unset → webhook answers 503.
REVALIDATE_SECRET=replace-with-another-long-random-string

# Where the contact form sends messages.
# unset          → /api/leads, which forwards to the API (a Lead in NULL Platform).
# "netlify-forms" → Netlify Forms stores each message and emails the team
#                   (hosting on Netlify with no API; turn on form detection
#                   and an email notification in the Netlify dashboard).
NEXT_PUBLIC_LEADS_VIA=

# Portal live updates. Unset → poll the unread-notification count (NULL
# Platform has no SignalR hub). "signalr" → connect to
# ${NEXT_PUBLIC_API_URL}/hubs/notifications instead.
NEXT_PUBLIC_REALTIME=

# Mock mode only: the NULL team's password at /team (admin@nullsolutions.jo).
# Unset → "null-team-dev" in development; team sign-in disabled in production.
MOCK_STAFF_PASSWORD=
